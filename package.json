{
  "name": "wealthtrack",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "migrate": "npm --prefix backend run migrate",
    "backup": "npm --prefix backend run backup",
    "import:excel": "npm --prefix backend run import:excel --",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
